{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "plugins": [
    "@nx/dotnet"
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": ["restore", "^build"]
    },
    "build:release": {
      "dependsOn": ["restore", "^build:release"]
    },
    "test": {
      "dependsOn": ["restore", "^build"]
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/ci.yml"
    ]
  },
  "neverConnectToCloud": true
}
